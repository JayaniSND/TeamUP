# ── Dev 3 (Agent layer) needs these ───────────────────────────────
# Claude does the reasoning inside the agents (Anthropic prize).
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Dev 2's FastAPI base URL. Defaults to the local mock backend below.
BACKEND_URL=http://127.0.0.1:8000

# Default athlete the agents write entries for when a dump doesn't
# specify one (Agentverse "Chat with Agent" sends plain text only).
DEFAULT_USER_ID=demo-athlete

# ── Voice ingestion (processing/voicetotext.py) ─────────────────────
# Deepgram prize / real-time transcription. Not in the original
# .env.example — added for the mic → Deepgram → Librarian pipeline.
DEEPGRAM_API_KEY=your-deepgram-key-here

# ── Agent addresses ────────────────────────────────────────────────
# Fill these in AFTER you start each agent once (they print their
# address to stdout on boot). The orchestrator/librarian use them to
# route messages. Leave blank to disable a downstream hop (the
# orchestrator falls back to running that step inline).
LIBRARIAN_ADDRESS=
RECOVERY_ADDRESS=
PERFORMANCE_ADDRESS=
SPONSORSHIP_ADDRESS=
LOGISTICS_ADDRESS=
SCOUT_ADDRESS=

# ── Logistics + Scout integrations (tournament / opponent search) ───
# Browserbase scrapes tournaments + opponent results. Optional: without
# these the agents use realistic cached fallbacks (the demo never depends
# on a live scrape).
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional: override the pages the scraper opens (use {q} for the query).
# TOURNAMENT_SEARCH_URL=https://www.bing.com/search?q={q}
# OPPONENT_SEARCH_URL=https://www.bing.com/search?q={q}

# Google Calendar (optional). Without creds, events still persist to the
# backend so the dashboard shows them; real GCal insert is a best-effort extra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── ASI:One bonus router (off the critical path) ───────────────────
ASI_ONE_API_KEY=

# ── Model selection (project defaults; override if you like) ───────
# Cheap+fast classifier for the Librarian, stronger model for Recovery
# synthesis. Matches the build plan's cost/latency choices.
CLASSIFY_MODEL=claude-haiku-4-5
SYNTHESIS_MODEL=claude-sonnet-4-6

#Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL = 

SUPABASE_URL= 
USER_ID=